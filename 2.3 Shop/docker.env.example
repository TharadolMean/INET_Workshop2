# Copy to .env before running docker compose. Use unique local development values.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-a-unique-password-12-to-72-characters
ADMIN_NAME=ElectroHub Admin

# Optional, only used by the guarded development demo seed command.
DEMO_SEED_CONFIRM=
DEMO_ADMIN_EMAIL=admin@example.local
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_EMAIL=customer@example.local
DEMO_CUSTOMER_PASSWORD=
