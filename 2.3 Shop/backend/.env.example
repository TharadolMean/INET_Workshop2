PORT=3000
MONGO_URI=mongodb://localhost:27017/workshop_2_3
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

# Admin ที่ถูกสร้างอัตโนมัติตอนเปิด server ครั้งแรก
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-a-unique-development-password
ADMIN_NAME=Admin

# Optional local demo seed; requires DEMO_SEED_CONFIRM=local-demo-only.
# Set unique 12-72 character passwords manually; there are no default credentials.
DEMO_SEED_CONFIRM=
DEMO_ADMIN_EMAIL=admin@example.local
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_EMAIL=customer@example.local
DEMO_CUSTOMER_PASSWORD=
